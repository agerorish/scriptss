createToggle(SettingsFrame, "Матовая графика (Комфортная)", 352, function(state)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if state then
                if not originalMaterials[obj] then
                    originalMaterials[obj] = obj.Material
                    originalShadowsState[obj] = obj.CastShadow
                end
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
            else
                if originalMaterials[obj] then
                    obj.Material = originalMaterials[obj]
                    obj.CastShadow = originalShadowsState[obj]
                end
            end
        elseif obj:IsA("Texture") or obj:IsA("Decal") then
            obj.Transparency = state and 1 or 0
        end
    end

    local cc = Lighting:FindFirstChild("RishColorCorrection")
    if state then
        if not cc then
            cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "RishColorCorrection"
            cc.Parent = Lighting
        end
        cc.Saturation = -0.75
        cc.Brightness = -0.15
        cc.Contrast = 0.10
    else
        if cc then cc:Destroy() end
    end
end)

