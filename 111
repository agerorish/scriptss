        if plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = true
                if root:FindFirstChild("HitboxVisualizer") then
                    root.HitboxVisualizer:Destroy()
